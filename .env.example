# Application Settings
APP_NAME=TenantGuard
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-64-char-hex-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com

# Database Settings
# For local zero-config run, leave SQLite default:
DATABASE_URL=sqlite:///./tenantguard.db
# For PostgreSQL / Docker:
# DATABASE_URL=postgresql+psycopg://tenantguard:tenantguard_pass@db:5432/tenantguard

# AI & RAG Configuration
# Options: "mock" (deterministic, zero-cost, offline) or "openai_compatible"
AI_PROVIDER=mock
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
MIN_SIMILARITY_THRESHOLD=0.18
TOP_K_CHUNKS=4

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite Settings (loaded from root .env via envDir: "..")
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# SMS delivery (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
